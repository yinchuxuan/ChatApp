{
  "schema": {
    "touma.affection": {
      "type": "number",
      "min": 0,
      "max": 100,
      "description": "冬马和纱对春希当前的好感度"
    },
    "setsuna.affection": {
      "type": "number",
      "min": 0,
      "max": 100,
      "description": "小木曾雪菜对春希当前的好感度"
    },
    "performance.proficiency": {
      "type": "number",
      "min": 0,
      "max": 100,
      "description": "学园祭演出熟练度；当本轮剧情包含合奏、练琴、排练、声乐/键盘/吉他磨合等演出练习时可以增加"
    },
    "visual.portrait": {
      "type": "enum",
      "values": [
        "none",
        "touma_normal",
        "touma_happy",
        "touma_sad",
        "touma_angry",
        "touma_surprise",
        "setsuna_normal",
        "setsuna_happy",
        "setsuna_sad",
        "setsuna_angry",
        "setsuna_surprise",
        "mizusawa_normal",
        "mizusawa_happy",
        "mizusawa_sad",
        "mizusawa_angry",
        "mizusawa_surprise",
        "takeya_normal",
        "takeya_happy",
        "takeya_sad",
        "takeya_angry",
        "takeya_surprise",
        "yanagihara_normal",
        "yanagihara_happy",
        "yanagihara_sad",
        "yanagihara_angry",
        "yanagihara_surprise"
      ],
      "description": "当前镜头立绘。选择画面视觉中心人物及其在目标段落开场时的表情；远景、春希独处或没有合适人物时写 none"
    },
    "visual.background": {
      "type": "enum",
      "values": [
        "musical_classroom3",
        "rooftop",
        "school",
        "classroom",
        "rooftop2",
        "park",
        "ktv",
        "home_party"
      ],
      "description": "当前镜头背景。第三音乐室写 musical_classroom3，天台写 rooftop 或 rooftop2，校园公共区域写 school，普通教室写 classroom，公园写 park，卡拉OK写 ktv，住宅聚会写 home_party"
    },
    "audio.bgm": {
      "type": "enum",
      "values": [
        "none",
        "daily",
        "happy",
        "normal",
        "sad",
        "tragic",
        "WA_piano",
        "WA_3",
        "dream",
        "snow_scene",
        "bad_woman",
        "after_all_piano",
        "winter_night",
        "things",
        "unstoppable_dream",
        "love_dream"
      ],
      "description": "当前镜头音乐。情绪没有明显变化时保持当前值；none 表示留白和静音"
    },
    "timeline.currentTime": {
      "type": "string",
      "description": "当前剧情具体时间点，格式固定为 YYYY.MM.DD: HH:mm 星期X"
    },
    "timeline.currentSlot": {
      "type": "string",
      "description": "当前剧情节点，只读，不要在 state_patch 中写入"
    },
    "timeline.currentSlotEnd": {
      "type": "string",
      "description": "当前剧情节点允许推进到的最晚时间，只读，不要在 state_patch 中写入"
    }
  }
}
