[
  {
    "id": "wa2-system-prompt",
    "when": { "phase": "init" },
    "then": [
      {
        "type": "insert",
        "role": "system",
        "content": "{{file:system_prompt}}",
        "_meta": { "source": "wa2_system_prompt", "visibility": "llm_only" }
      },
      {
        "type": "insert",
        "role": "system",
        "content": "# 历史记忆\n\n只有“知情”列表中的人物可以在对白、判断和行动中使用对应信息；未列出的人物默认不知道，“公开”表示所有相关人物均可知道。\n\n## 剧情锚点\n暂无。\n\n## 当前事项\n以下是上一轮结束时仍有效的完整事项。回复结束时必须重新输出仍有效的全部 current_event。\n暂无。\n\n## 近期事件\n暂无。",
        "_meta": { "source": "wa2_summary", "visibility": "llm_only" }
      },
      {
        "type": "insert",
        "role": "assistant",
        "content": "{{file:first_msg}}",
        "_meta": {
          "source": "wa2_first_msg",
          "visibility": "user_visible",
          "statePatchPlayback": { "appliedPatchCount": 0, "afterResponseApplied": true }
        }
      }
    ]
  },
  {
    "id": "wa2-refresh-system-prompt",
    "when": { "phase": "pre_send" },
    "then": [
      {
        "type": "replace",
        "predicate": { "_meta.source": "wa2_system_prompt" },
        "content": "{{file:system_prompt}}"
      }
    ]
  }
]
