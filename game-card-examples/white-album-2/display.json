{
  "stylesheet": "display.css",
  "segmentedReading": true,
  "segmentSeparator": "\n",
  "assistant": [
    {
      "id": "wa2-hide-summary-block",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "\\n*---\\s*\\n\\s*<summary>[\\s\\S]*?<\\/summary>\\s*\\n\\s*---\\s*",
      "flags": "g",
      "replace": "\n\n"
    },
    {
      "id": "wa2-hide-summary-tag",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "<summary>[\\s\\S]*?<\\/summary>",
      "flags": "g",
      "replace": ""
    },
    {
      "id": "wa2-scene-time-place",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "^【时间地点】\\s*([^\\n｜|]+?)\\s*[｜|]\\s*([^\\n]+)$",
      "flags": "gm",
      "replace": "<div class=\"wa2-scene-meta\"><span class=\"wa2-scene-time\">$1</span><span class=\"wa2-scene-place\">$2</span></div>"
    },
    {
      "id": "wa2-group-choice-lines",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "^([A-D]\\.\\s+.+)\\n[ \\t]*\\n(?=[A-D]\\.\\s+)",
      "flags": "gm",
      "replace": "$1\n"
    },
    {
      "id": "wa2-choice-overlay",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "^(?:<choices>[ \\t]*\\n)?A\\.\\s+(.+)\\nB\\.\\s+(.+)\\nC\\.\\s+(.+)\\nD\\.\\s+(.+)(?:\\n[ \\t]*<\\/choices>)?$",
      "flags": "gm",
      "replace": "<div class=\"wa2-choice-overlay\" role=\"group\" aria-label=\"请选择下一步行动\"><div class=\"wa2-choice-prompt\">请选择下一步行动</div><button type=\"button\" class=\"wa2-choice\" data-gc-chat-input-label=\"A\" data-gc-chat-input-text-selector=\".wa2-choice-text\"><span class=\"wa2-choice-label\">A</span><span class=\"wa2-choice-text\">$1</span></button><button type=\"button\" class=\"wa2-choice\" data-gc-chat-input-label=\"B\" data-gc-chat-input-text-selector=\".wa2-choice-text\"><span class=\"wa2-choice-label\">B</span><span class=\"wa2-choice-text\">$2</span></button><button type=\"button\" class=\"wa2-choice\" data-gc-chat-input-label=\"C\" data-gc-chat-input-text-selector=\".wa2-choice-text\"><span class=\"wa2-choice-label\">C</span><span class=\"wa2-choice-text\">$3</span></button><button type=\"button\" class=\"wa2-choice\" data-gc-chat-input-label=\"D\" data-gc-chat-input-text-selector=\".wa2-choice-text\"><span class=\"wa2-choice-label\">D</span><span class=\"wa2-choice-text\">$4</span></button></div>"
    }
  ],
  "user": [
    {
      "id": "wa2-hide-user-turn-context",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "\\n*---\\s*\\n\\s*<wa2_turn_context>[\\s\\S]*?<\\/wa2_turn_context>\\s*$",
      "flags": "g",
      "replace": ""
    },
    {
      "id": "wa2-hide-user-turn-context-tag",
      "stage": "before_markdown",
      "type": "regex_replace",
      "pattern": "<wa2_turn_context>[\\s\\S]*?<\\/wa2_turn_context>",
      "flags": "g",
      "replace": ""
    }
  ]
}
