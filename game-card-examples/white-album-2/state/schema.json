{
  "schema": {
    "touma.affection": {
      "type": "number",
      "default": 18,
      "min": 0,
      "max": 100,
      "onInvalid": "clamp",
      "description": "冬马和纱对玩家/春希当前路线的好感度",
      "llmRead": true,
      "uiVisible": true
    },
    "setsuna.affection": {
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 100,
      "onInvalid": "clamp",
      "description": "小木曾雪菜对玩家/春希当前路线的好感度",
      "llmRead": true,
      "uiVisible": true
    },
    "performance.proficiency": {
      "type": "number",
      "default": 2,
      "min": 0,
      "max": 100,
      "onInvalid": "clamp",
      "description": "学园祭演出熟练度。由 LLM 在合奏、练琴、排练、声乐/键盘/吉他磨合等练习剧情中写入。",
      "llmRead": true,
      "llmWrite": true,
      "uiVisible": true
    },
    "visual.scene": {
      "type": "enum",
      "values": [
        "none",
        "musical_classroom2",
        "musical_classroom3",
        "school",
        "classroom",
        "apartment_morning",
        "apartment_afternoon",
        "apartment_night",
        "classroom_morning",
        "classroom_afternoon",
        "classroom_night",
        "corridor_morning",
        "corridor_afternoon",
        "corridor_night",
        "musical_classroom2_morning",
        "musical_classroom2_afternoon",
        "musical_classroom2_night",
        "musical_classroom3_morning",
        "musical_classroom3_afternoon",
        "musical_classroom3_night",
        "school_morning",
        "school_afternoon",
        "school_night",
        "setsuna_room_morning",
        "setsuna_room_afternoon",
        "setsuna_room_night",
        "stairs_morning",
        "stairs_afternoon",
        "stairs_night",
        "street_morning",
        "street_afternoon",
        "street_night",
        "subway_station_morning",
        "subway_station_afternoon",
        "subway_station_night",
        "invite",
        "rooftop",
        "haiku",
        "rooftop2",
        "park",
        "touma_hand",
        "ktv",
        "home_party",
        "agreement",
        "GameEnd1"
      ],
      "default": "musical_classroom3",
      "description": "当前演出基础画面，可以是允许叠加立绘的背景或屏蔽立绘的剧情 CG，只由 LLM 的分段 state_patch 设置。",
      "llmRead": true,
      "llmWrite": true
    },
    "visual.portraits": {
      "type": "object",
      "properties": {
        "touma": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile", "sleep"]
        },
        "setsuna": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "mizusawa": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "takeya": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "chikashi": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "yanagihara": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "takahiro": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "teacher1": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        },
        "teacher2": {
          "type": "enum",
          "values": ["normal", "happy", "sad", "cry", "angry", "surprise", "joy", "sweating_smile"]
        }
      },
      "additionalProperties": false,
      "maxProperties": 4,
      "default": {},
      "description": "当前镜头可见人物及其表情，最多四人；位置由平台自动编排。",
      "llmRead": true,
      "llmWrite": true
    },
    "audio.bgm": {
      "type": "enum",
      "values": [
        "none",
        "daily",
        "happy",
        "light",
        "hope",
        "release",
        "peace",
        "steady",
        "desolate",
        "sad",
        "tragic",
        "WA_piano",
        "WA_3",
        "dream",
        "snow_scene",
        "bad_woman",
        "after_all_piano",
        "winter_night",
        "things",
        "unstoppable_dream",
        "love_dream",
        "WA_formal",
        "normal_ex"
      ],
      "default": "daily",
      "description": "当前演出 BGM；none 表示静音，只由 LLM 的分段 state_patch 设置。",
      "llmRead": true,
      "llmWrite": true
    },
    "timeline.currentTime": {
      "type": "string",
      "default": "2007.10.20: 15:00 星期六",
      "description": "当前剧情具体时间点，格式固定为 YYYY.MM.DD: HH:mm 星期X。LLM 每轮用 state.set 写入本轮正文结束时的时间，剧情引导按该时间落入的区间选择。",
      "llmRead": true,
      "llmWrite": true
    },
    "timeline.currentSlot": {
      "type": "string",
      "default": "FreePlot1",
      "description": "当前剧情节点，由 timeline resolver 写入，LLM 只读。",
      "llmRead": true,
      "llmWrite": false
    },
    "timeline.currentSlotEnd": {
      "type": "string",
      "default": "",
      "description": "当前剧情节点允许推进到的最晚时间，由 timeline resolver 写入，LLM 只读。",
      "llmRead": true,
      "llmWrite": false
    },
    "story.chapter": {
      "type": "enum",
      "values": ["chapter_1", "chapter_2"],
      "default": "chapter_1",
      "description": "当前剧情章节。章节 timeline resolver 根据该值选择对应章节的剧情映射。",
      "llmRead": true,
      "llmWrite": true
    },
    "story.route": {
      "type": "enum",
      "values": ["common"],
      "default": "common",
      "description": "当前剧情路线。后续章节可用该值切换不同路线的剧情映射。",
      "llmRead": true,
      "llmWrite": true
    },
    "story.progress": {
      "type": "string",
      "default": "FreePlot1",
      "description": "当前章节内的时间轴 slot，由 timeline resolver 写入，供调试和后续章节切换使用。",
      "llmRead": true,
      "llmWrite": false
    },
    "story.chapter2SetsunaBranch": {
      "type": "enum",
      "values": ["undecided", "secret", "reserved"],
      "default": "undecided",
      "description": "第二章雪菜邀请分支。secret 表示雪菜向春希袒露KTV秘密，reserved 表示雪菜加入同好会但仍保留私人秘密。由 timeline resolver 写入。",
      "llmRead": false,
      "llmWrite": false
    },
    "story.chapter2GameEnd1Reached": {
      "type": "boolean",
      "default": false,
      "description": "第二章 GameEnd1 结局固定节点是否已经加载。为 true 后后续轮次进入 GameEnd1 日后谈自由剧情。",
      "llmRead": false,
      "llmWrite": false
    },
    "story.chapter2SuccessReached": {
      "type": "boolean",
      "default": false,
      "description": "第二章同好会重建成功节点是否已经加载。为 true 后后续轮次进入成功结局日后谈。",
      "llmRead": false,
      "llmWrite": false
    },
    "memory.summary": {
      "type": "object",
      "default": {
        "version": 2,
        "anchor": [],
        "currentEvents": [],
        "recent": [],
        "turn": 0
      },
      "description": "WA2结构化剧情记忆，由游戏卡压缩脚本维护。",
      "llmRead": false,
      "llmWrite": false,
      "uiVisible": false
    },
    "visual.textPanel": {
      "type": "enum",
      "values": ["center", "left", "right"],
      "default": "right",
      "description": "剧情阅读面板位置",
      "llmRead": false,
      "llmWrite": false
    }
  }
}
