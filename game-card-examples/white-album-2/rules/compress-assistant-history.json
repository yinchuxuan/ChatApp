[
    {"id":"wa2-apply-initial-summary",
     "when":{"phase":"init","last":{"role":"assistant","content":{"regex":"<summary>[\\s\\S]*?</summary>"}}},
     "then":[
        {"type":"exec","sourceFile":"scripts/summary-memory.js"}
     ]
    },
    {"id":"wa2-apply-response-summary",
     "when":{"phase":"after_stream","last":{"role":"assistant","content":{"regex":"<summary>[\\s\\S]*?</summary>"}}},
     "then":[
        {"type":"exec","sourceFile":"scripts/summary-memory.js"}
     ]
    },
    {"id":"wa2-compress-assistant-history",
     "when":{
        "phase":"pre_send",
        "any":{"role":"assistant",
               "content":{"regex":"<summary>[\\s\\S]*?</summary>"},
               "occurrence":"not_last"}
            },
     "then":[
        {"type":"remove",
         "predicate":{"role":"assistant",
                      "content":{"regex":"<summary>[\\s\\S]*?</summary>"},
                      "occurrence":"not_last"}
        }
     ]
    },
    {"id":"wa2-keep-latest-user",
     "when":{"phase":"pre_send"},
     "then":[
        {"type":"remove",
         "predicate":{"role":"user","not":{"index":"last"}}
        }
     ]
    }
]
