{
  "onFailure": "warn",
  "rules": [
    {
      "id": "error-leading-state-patch",
      "type": "content.regex",
      "source": "raw",
      "pattern": "^\\s*<state_patch>[\\s\\S]*?<\\/state_patch>",
      "matches": { "eq": 1 },
      "message": "【建议重新生成】回复必须以一个完整的前导 state_patch 开始"
    },
    {
      "id": "error-state-patch-count",
      "type": "content.regex",
      "source": "raw",
      "pattern": "<state_patch>[\\s\\S]*?<\\/state_patch>",
      "matches": { "gte": 2 },
      "message": "【建议重新生成】回复必须同时包含前导 patch 和本轮结算 patch"
    },
    {
      "id": "error-current-time-update",
      "type": "state.update",
      "path": "timeline.currentTime",
      "updates": { "eq": 1 },
      "operations": ["state.set"],
      "value": { "regex": "^\\d{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12]\\d|3[01]): (?:[01]?\\d|2[0-3]):[0-5]\\d 星期[一二三四五六日]$" },
      "message": "【建议重新生成】本轮必须且只能用合法格式结算一次 timeline.currentTime"
    },
    {
      "id": "error-touma-affection-update",
      "type": "state.update",
      "path": "touma.affection",
      "updates": { "lte": 1 },
      "operations": ["state.set"],
      "delta": { "gte": -5, "lte": 5 },
      "message": "【建议重新生成】冬马好感度单轮只能更新一次，变化幅度不得超过 5"
    },
    {
      "id": "error-setsuna-affection-update",
      "type": "state.update",
      "path": "setsuna.affection",
      "updates": { "lte": 1 },
      "operations": ["state.set"],
      "delta": { "gte": -5, "lte": 5 },
      "message": "【建议重新生成】雪菜好感度单轮只能更新一次，变化幅度不得超过 5"
    },
    {
      "id": "error-proficiency-update",
      "type": "state.update",
      "path": "performance.proficiency",
      "updates": { "lte": 1 },
      "operations": ["state.set"],
      "delta": { "gte": -5, "lte": 5 },
      "message": "【建议重新生成】演出熟练度单轮只能更新一次，增减幅度不得超过 5"
    },
    {
      "id": "error-protected-current-slot",
      "type": "state.update",
      "path": "timeline.currentSlot",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的 timeline.currentSlot"
    },
    {
      "id": "error-protected-current-slot-end",
      "type": "state.update",
      "path": "timeline.currentSlotEnd",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的 timeline.currentSlotEnd"
    },
    {
      "id": "error-protected-story-chapter",
      "type": "state.update",
      "path": "story.chapter",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的 story.chapter"
    },
    {
      "id": "error-protected-story-route",
      "type": "state.update",
      "path": "story.route",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的 story.route"
    },
    {
      "id": "error-protected-story-progress",
      "type": "state.update",
      "path": "story.progress",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的 story.progress"
    },
    {
      "id": "error-protected-setsuna-branch",
      "type": "state.update",
      "path": "story.chapter2SetsunaBranch",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的雪菜剧情分支"
    },
    {
      "id": "error-protected-game-end",
      "type": "state.update",
      "path": "story.chapter2GameEnd1Reached",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的失败结局状态"
    },
    {
      "id": "error-protected-success-end",
      "type": "state.update",
      "path": "story.chapter2SuccessReached",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的成功结局状态"
    },
    {
      "id": "error-protected-summary-memory",
      "type": "state.update",
      "path": "memory.summary",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得直接修改系统维护的 summary memory"
    },
    {
      "id": "error-protected-text-panel",
      "type": "state.update",
      "path": "visual.textPanel",
      "updates": { "eq": 0 },
      "message": "【建议重新生成】模型不得修改系统维护的 visual.textPanel"
    },
    {
      "id": "error-summary-count",
      "type": "content.regex",
      "pattern": "<summary>[\\s\\S]*?<\\/summary>",
      "matches": { "eq": 1 },
      "message": "【建议重新生成】回复必须且只能包含一个完整的 summary"
    },
    {
      "id": "error-summary-structure",
      "type": "content.regex",
      "pattern": "<summary>\\s*(?:<item priority=\"(?:anchor|current_event|recent)\" known_by=\"(?:公开|(?:北原春希|冬马和纱|小木曾雪菜|饭冢武也|水泽依绪|早坂亲志|柳原朋|小木曾孝宏|三年E班班主任|诹访老师)(?:,(?:北原春希|冬马和纱|小木曾雪菜|饭冢武也|水泽依绪|早坂亲志|柳原朋|小木曾孝宏|三年E班班主任|诹访老师))*)\">[^<]*<\\/item>\\s*)+<\\/summary>",
      "matches": { "eq": 1 },
      "message": "【建议重新生成】summary 只能包含 priority 和 known_by 均合法的结构化 item"
    },
    {
      "id": "error-current-event-required",
      "type": "content.regex",
      "pattern": "<item priority=\"current_event\" known_by=\"[^\"]+\">",
      "matches": { "gte": 1 },
      "message": "【建议重新生成】summary 必须完整重写 current_event；没有事项时也要明确写无当前事项"
    },
    {
      "id": "error-choices-count",
      "type": "content.regex",
      "pattern": "<choices>[\\s\\S]*?<\\/choices>",
      "matches": { "eq": 1 },
      "message": "【建议重新生成】回复必须且只能包含一个完整的 choices"
    },
    {
      "id": "error-choices-structure",
      "type": "content.regex",
      "pattern": "<choices>[ \\t]*\\r?\\n[ \\t]*A\\.[ \\t]+[^\\r\\n]+(?:\\r?\\n[ \\t]*)+B\\.[ \\t]+[^\\r\\n]+(?:\\r?\\n[ \\t]*)+C\\.[ \\t]+[^\\r\\n]+(?:\\r?\\n[ \\t]*)+D\\.[ \\t]+[^\\r\\n]+(?:\\r?\\n)?[ \\t]*<\\/choices>",
      "matches": { "eq": 1 },
      "message": "【建议重新生成】choices 内必须且只能包含独占一行的 A、B、C、D 四个选项"
    },
    {
      "id": "warning-time-location-required",
      "type": "content.regex",
      "pattern": "^【时间地点】\\d{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12]\\d|3[01]): (?:[01]?\\d|2[0-3]):[0-5]\\d 星期[一二三四五六日]｜[^\\r\\n｜]+$",
      "flags": "mu",
      "matches": { "gte": 1 },
      "message": "【质量提醒】回复中缺少格式正确的时间地点行"
    },
    {
      "id": "warning-time-location-format",
      "type": "content.regex",
      "pattern": "^【时间地点】(?!\\d{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12]\\d|3[01]): (?:[01]?\\d|2[0-3]):[0-5]\\d 星期[一二三四五六日]｜[^\\r\\n｜]+$)[^\\r\\n]*$",
      "flags": "mu",
      "matches": { "eq": 0 },
      "message": "【质量提醒】存在格式不规范的时间地点行"
    },
    {
      "id": "warning-summary-anchor-count",
      "type": "content.regex",
      "pattern": "<item priority=\"anchor\" known_by=\"[^\"]+\">",
      "matches": { "lte": 1 },
      "message": "【质量提醒】summary 每轮最多记录一条新增 anchor"
    },
    {
      "id": "warning-summary-current-event-count",
      "type": "content.regex",
      "pattern": "<item priority=\"current_event\" known_by=\"[^\"]+\">",
      "matches": { "lte": 8 },
      "message": "【质量提醒】summary 中的 current_event 超过八条"
    },
    {
      "id": "warning-summary-recent-count",
      "type": "content.regex",
      "pattern": "<item priority=\"recent\" known_by=\"[^\"]+\">",
      "matches": { "lte": 2 },
      "message": "【质量提醒】summary 每轮最多记录两条 recent"
    },
    {
      "id": "warning-summary-event-format",
      "type": "content.regex",
      "pattern": "<item priority=\"(?:anchor|recent)\" known_by=\"[^\"]+\">(?!(?:[^\\r\\n<｜]+｜[^\\r\\n<：]+：[^<]+)<\\/item>)[^<]*<\\/item>",
      "matches": { "eq": 0 },
      "message": "【质量提醒】anchor 和 recent 应使用“时间｜主要地点：事件”格式"
    },
    {
      "id": "warning-content-length",
      "type": "content.regex",
      "pattern": "[\\u3400-\\u4DBF\\u4E00-\\u9FFF]",
      "flags": "u",
      "matches": { "gte": 3000, "lte": 5000 },
      "message": "【质量提醒】非 state_patch 内容的汉字数量不在 3000 至 5000 范围内"
    },
    {
      "id": "warning-writing-style",
      "type": "content.regex",
      "pattern": "(?:不是[^。！？\\n]{0,40}而是|并不是[^。！？\\n]{0,40}而是|不只是[^。！？\\n]{0,40}更是|与其[^。！？\\n]{0,40}不如|这一刻|某种意义上|说不清道不明|复杂的情绪|空气中弥漫着|命运的齿轮)",
      "matches": { "eq": 0 },
      "message": "【质量提醒】回复使用了文风规则明确禁止的表达"
    },
    {
      "id": "warning-japanese-kana",
      "type": "content.regex",
      "pattern": "[\\u3040-\\u30ff]",
      "flags": "u",
      "matches": { "eq": 0 },
      "message": "【质量提醒】回复中出现了不应使用的日文假名"
    }
  ]
}
